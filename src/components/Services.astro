---

<section id="servicios" class="py-24 bg-legal-black">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    {/* Encabezado de la sección */}
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">Áreas de <span class="text-legal-beige italic font-serif">Práctica</span></h2>
      <p class="text-legal-light opacity-80 max-w-2xl mx-auto text-lg">
        Brindamos soluciones jurídicas precisas en diversas ramas del derecho, adaptándonos a las necesidades específicas de cada cliente.
      </p>
    </div>

    {/* Grilla de Tarjetas (CSS Grid) */}
    {/* grid-cols-1 (celu) -> md:grid-cols-2 (tablet) -> lg:grid-cols-3 (compu) */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      {/* Recorremos el array de áreas de práctica */}
      {areasDePractica.map((area) => (
        <div class="group bg-legal-black border border-legal-beige/10 p-8 rounded-sm hover:border-legal-beige/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-legal-beige/5">
          
          {/* Ícono de la tarjeta */}
          <div class="w-12 h-12 bg-legal-dark rounded-full flex items-center justify-center mb-6 group-hover:bg-legal-beige transition-colors duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-legal-beige group-hover:text-legal-black transition-colors duration-300">
              <path stroke-linecap="round" stroke-linejoin="round" d={area.icono} />
            </svg>
          </div>

          {/* Textos de la tarjeta */}
          <h3 class="text-xl font-bold text-white mb-4 group-hover:text-legal-beige transition-colors duration-300">{area.titulo}</h3>
          <p class="text-legal-light opacity-70 leading-relaxed font-light">
            {area.descripcion}
          </p>
        </div>
      ))}

    </div>
  </div>
</section>