---
const valores = [
  { numero: '01', titulo: 'Cercanía en cada paso', texto: 'Trato directo con el profesional a cargo de tu caso. Escuchamos tu situación y respondemos tus dudas.' },
  { numero: '02', titulo: 'Claridad para decidir', texto: 'Información transparente sobre las alternativas, los costos y los plazos de tu proceso.' },
  { numero: '03', titulo: 'Una estrategia para vos', texto: 'Cada situación es distinta. Trabajamos en una solución jurídica que contemple tus necesidades.' },
];
---

<section id="equipo" class="about-section section-space" aria-labelledby="about-title">
  <div class="site-container about-grid">
    <div>
      <p class="eyebrow">01 / El estudio</p>
      <h2 id="about-title" class="section-title">El derecho, con una<br /><em>mirada humana.</em></h2>
      <p class="section-description">Somos un estudio jurídico dedicado a brindar soluciones legales estratégicas. Entendemos que cada caso es único y merece tiempo, escucha y compromiso.</p>
      <p class="section-description">Te acompañamos en cada instancia judicial o extrajudicial para que puedas tomar decisiones con información y confianza.</p>
      <a href="#contacto" class="text-link dark-link">Hablemos de tu situación <span aria-hidden="true">↗</span></a>
    </div>
    <div class="values-list">
      {valores.map((valor) => <article class="value-row"><span>{valor.numero}</span><div><h3>{valor.titulo}</h3><p>{valor.texto}</p></div></article>)}
    </div>
  </div>
</section>
